{
  "name": "backstage-music",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "build:web": "npm run build && node scripts/publish-installers.mjs",
    "stage:installers": "node scripts/stage-installers.mjs",
    "release:version": "node scripts/prepare-release.mjs",
    "release:next": "npm run release:version && npm test && npm run release:local && npm run prepare:deploy",
    "prepare:deploy": "node scripts/prepare-vercel.mjs",
    "deploy:release": "npx --yes vercel@65.8.0 deploy --prebuilt --prod --yes && npm run verify:release",
    "verify:release": "node scripts/verify-release.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && electron electron/main.cjs",
    "dist:win": "npm run build && electron-builder --win --publish never --config.win.signAndEditExecutable=false",
    "build:apk": "npm run android:sync && node scripts/build-android.mjs",
    "verify:apk": "node scripts/verify-apk.mjs",
    "release:local": "npm run build:apk && npm run verify:apk && npm run dist:win && npm run stage:installers && npm run build:web",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-media-session": "^8.1.6",
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.backstage.music",
    "productName": "Backstage Music",
    "directories": {
      "output": "artifacts/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Backstage-Music-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://backstage-music.vercel.app/downloads/"
      }
    ]
  }
}
